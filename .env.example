# Get a Gemini API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=replace_me
# Optional: choose a Gemini model supported by your account
GRAPHMIND_MODEL=gemini-2.5-flash

# FalkorDB Database Configuration
# Option 1: Connection URL (Recommended for FalkorDB Cloud: https://app.falkordb.cloud)
# FALKORDB_URL=falkor://default:your-password@your-endpoint.falkordb.cloud:port
# FALKORDB_URL=falkors://default:your-password@your-endpoint.falkordb.cloud:port  # with SSL

# Option 2: Host & Port (Local Docker or Private Service)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# FALKORDB_USERNAME=default
# FALKORDB_PASSWORD=
# FALKORDB_SSL=false
FALKORDB_GRAPH=graphmind

# API URL for Streamlit UI
API_BASE_URL=http://127.0.0.1:8000

# Automatically seed demo data on application startup (true/false)
AUTO_SEED=true
